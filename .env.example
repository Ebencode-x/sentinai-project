# SentinAI environment configuration
# Copy to .env and fill in values. Never commit .env to version control.

# Core
APP_NAME=SentinAI
LOG_FILE_PATH=logs/app.log
MAX_RECENT_INCIDENTS=100
INCIDENT_DEDUPE_WINDOW=200

# LLM provider — options: stub | openai | claude
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1.0

# Milestone 3: Notifications
# Slack Incoming Webhook URL (leave blank to disable)
SENTINAI_SLACK_WEBHOOK_URL=

# Generic HTTP webhook — PagerDuty / n8n / Zapier / Linear (critical only)
SENTINAI_GENERIC_WEBHOOK_URL=

# Per-notification request timeout in seconds
NOTIFICATION_TIMEOUT_SECONDS=8

# Routing: critical -> Slack + webhook | warning -> Slack only
# confidence < 0.5  -> flagged low-confidence in payload
# source = fallback -> flagged provider-degraded in payload

# Milestone 6: Auto-patch PR workflow
# GitHub Personal Access Token (needs repo + pull_request scopes)
GITHUB_TOKEN=
# Target repository in owner/repo format (e.g. Ebencode-x/sentinai-project)
GITHUB_REPO=

# Database for accounts and sessions. Default: a local SQLite file.
# Use a PostgreSQL URL (postgresql://user:pass@host/db) for production.
# DATABASE_URL=sqlite:///./sentinai.db

# Migrations and the first admin are created automatically at startup.
# Set SENTINAI_AUTO_MIGRATE=0 if you manage migrations yourself.
# SENTINAI_AUTO_MIGRATE=1

# First admin login. If you leave these unset, SentinAI creates
# admin@sentinai.local with a random one-time password and prints it once in the
# startup log. Set both before any public deployment.
# SENTINAI_ADMIN_EMAIL=you@example.com
# SENTINAI_ADMIN_PASSWORD=

# Rate limiting
SENTINAI_LLM_RATE_LIMIT=10
SENTINAI_PR_RATE_LIMIT=3

# Frontend origins allowed to call the API (comma-separated)
# SENTINAI_CORS_ORIGINS=https://app.sentinai.io,https://sentinai.io
