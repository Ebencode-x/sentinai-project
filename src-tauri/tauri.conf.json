{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SentinAI",
  "version": "0.1.0",
  "identifier": "com.sentinai.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{
      "title": "SentinAI",
      "width": 1280,
      "height": 800,
      "minWidth": 960,
      "minHeight": 600,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "csp": "default-src self unsafe-inline; connect-src self http://127.0.0.1:8000 ws://127.0.0.1:8000 https://ebencode-x-sentinai.hf.space; font-src self https://fonts.googleapis.com https://fonts.gstatic.com data:; style-src self unsafe-inline https://fonts.googleapis.com; script-src self unsafe-inline unsafe-eval"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"],
    "android": { "debugApplicationIdSuffix": ".debug" }
  }
}
